    # replace_in_single_run_paragraph(para, "<old>", "<new>")
    # print("✓ A) <Kurzbeschreibung>")

    # PATCH_B: <Beschreibung>
    # para = next(p for p in paras if p.text.startswith("<Start-Substring>"))
    # insert_paragraph_after(para, "<Neuer Absatz-Text>")
    # print("✓ B) <Kurzbeschreibung>")

    # === END PATCHES ===

    doc.save(str(DST))
    print(f"\n✓ Gespeichert: {DST.relative_to(PROJECT)}")


if __name__ == "__main__":
    main()
